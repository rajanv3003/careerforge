# CareerForge — required environment variables (copy to .env and fill in)
# The host (Render/Vercel) sets PORT automatically; only set it locally.
PORT=3456

# DeepSeek — PRIMARY brain (all text agents). Get an sk-... key from deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Gemini — optional fallback (used only if DEEPSEEK_API_KEY is empty). Needs a real AIza... key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gathos — AI cover images + voice (optional)
GATHOS_BASE_URL=https://gathos.com/api/v1
GATHOS_IMAGE_API_KEY=
GATHOS_I2I_API_KEY=
GATHOS_TTS_API_KEY=

# Path to Chromium (Docker sets this to /usr/bin/chromium automatically)
CHROME_PATH=
