# CareerForge — required environment variables (copy to .env and fill in)
PORT=3456

# Gemini (primary LLM)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# DeepSeek (fallback LLM)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Gathos (AI images / TTS for banners)
GATHOS_BASE_URL=https://gathos.com/api/v1
GATHOS_IMAGE_API_KEY=
GATHOS_TTS_API_KEY=
